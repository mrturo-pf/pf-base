  "cards": [
    {
      "dot": "rose",
      "title": "Public ingress",
      "items": [
        "GCP API Gateway is the public API-key enforcement point",
        "pf-svc-gateway-proxy routes every external and service-to-service income/reference request with workload identity tokens",
        "Direct Cloud Run URLs are not the consumer path"
      ]
    },
    {
      "dot": "cyan",
      "title": "Runtime",
      "items": [
        "pf-svc-income and pf-svc-reference are independent FastAPI microservices",
        "pf-svc-income reaches pf-svc-reference through pf-svc-gateway-proxy (never directly)",
        "Both connect to the same PostgreSQL instance"
      ]
    },
    {
      "dot": "emerald",
      "title": "Schema ownership",
      "items": [
        "pf-db is the single source of truth for DDL and migrations",
        "pf-svc-reference owns REF_RATE_UNIT, REF_RATE_VALUE, REF_ECON_INDEX, REF_TAX_BRCKT, and REF_EXPORT_JOB",
        "pf-svc-income owns all other income tables"
      ]
    },
    {
      "dot": "violet",
      "title": "Shared tooling",
      "items": [
        "pf-svc-common provides reusable Make targets used by pf-svc-income and pf-svc-reference",
        "Not used by pf-db"
      ]
    },
    {
      "dot": "amber",
      "title": "Sheets integration",
      "items": [
        "pf-sheets is a Google Apps Script macro, deployed via clasp",
        "Triggers a pf-svc-reference export over HTTP, then reads the CSV from Drive and upserts it into a Sheet",
        "Does not touch PostgreSQL directly"
      ]
    },
    {
      "dot": "slate",
      "title": "Want more detail?",
      "items": [
        "This is the shallow, system-context view -- each box hides real internal layers",
        "Open architecture/index.html for a linked list of all diagrams",
        "Or directly: pf-svc-income.html, pf-svc-reference.html, pf-sheets.html (hexagonal/internal layers), pf-db.html (table ownership)"
      ]
    }
  ]
