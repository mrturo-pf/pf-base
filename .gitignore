# Subprojects are independent git repos (their own .git, remote, history).
# This root repo (pf-base) only tracks ecosystem-level docs/config
# (AGENTS.md, README.md, architecture/) — ignore the subrepo folders
# so `git status` here stays clean instead of showing them as untracked.
/modules/

# OS cruft
.DS_Store

# Local runtime logs from scripts/pf-services.sh
/scripts/logs/

# Personal search-words.sh config -- copy scripts/search-words-example.jsonc
# to scripts/search-words.json and edit locally, never committed.
/scripts/search-words.json

# Common local-only stuff, in case anything ever lands directly at root
node_modules/
.env
.env.*
venv/
.venv/
__pycache__/
*.pyc

# Postman: pf-ecosystem.postman_environment.*.json files ARE committed, but
# their api-key values are always empty placeholders -- real values only
# ever exist in GitHub Secrets, injected at sync time by
# .github/workflows/sync-postman.yml. Never hand-edit a real key into one
# of those files and commit it.
