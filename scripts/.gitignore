# Runtime Cloud Shell and Neon outputs/configuration.
# Shell scripts are not versioned except for the reviewed Neon base template.
**/*.sh
!scripts/neon/pf-neon-script-base.sh

cloudshell/*/
cloudshell/*.tar.gz
neon/*/
neon/*.txt
neon/*.json
!neon/neon-config.json.example
!neon/pf-neon-script-base.sh
